{
  "name": "dsh-paper-vault",
  "version": "0.1.2",
  "description": "Local-first paper vault for DSH: arXiv discovery, import by arXiv/DOI/URL, PDFs, tags, per-paper notes and BibTeX — no CLI, no native modules.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0",
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "papers",
    "arxiv",
    "literature",
    "notes",
    "bibtex"
  ],
  "author": "lazy-fur2025",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lazy-fur2025/dsh-paper-vault.git"
  },
  "homepage": "https://github.com/lazy-fur2025/dsh-paper-vault#readme",
  "bugs": {
    "url": "https://github.com/lazy-fur2025/dsh-paper-vault/issues"
  },
  "license": "MIT"
}
